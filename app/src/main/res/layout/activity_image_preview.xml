<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".feature.history.presentation.ImagePreviewActivity">

    <com.example.sscan.feature.history.presentation.ZoomableImageView
        android:id="@+id/previewImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/history_click_view_image"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/space_4"
        android:background="@android:color/transparent"
        android:contentDescription="@string/page_back"
        android:padding="@dimen/space_2"
        android:src="@drawable/ic_back"
        app:tint="@android:color/white" />

</FrameLayout>
