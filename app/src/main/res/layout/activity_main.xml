<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_5"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/space_5"
            android:paddingBottom="20dp">

            <!-- ══════ 品牌头：logo + 名称 ══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_home_logo"
                    android:contentDescription="@string/app_name"
                    android:padding="@dimen/space_2"
                    android:src="@drawable/ic_scan_box"
                    app:tint="@color/text_inverse" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_xl"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>

            <!-- ══════ 今日数据：无框排布，靠留白分隔 ══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <!-- 今日扫描 -->
                <LinearLayout
                    style="@style/HomeStatTile"
                    android:layout_marginEnd="@dimen/space_2">

                    <LinearLayout style="@style/HomeStatHead">

                        <ImageView
                            style="@style/HomeStatIcon"
                            android:src="@drawable/ic_home_scan"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/HomeStatLabel"
                            android:text="@string/home_stat_today" />
                    </LinearLayout>

                    <LinearLayout style="@style/HomeStatNumberRow">

                        <TextView
                            android:id="@+id/statTodayValue"
                            style="@style/HomeStatValue"
                            tools:text="12" />

                        <TextView
                            style="@style/HomeStatUnit"
                            android:text="@string/home_stat_unit_times" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 累计记录 -->
                <LinearLayout
                    style="@style/HomeStatTile"
                    android:layout_marginEnd="@dimen/space_2">

                    <LinearLayout style="@style/HomeStatHead">

                        <ImageView
                            style="@style/HomeStatIcon"
                            android:src="@drawable/ic_setting_history"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/HomeStatLabel"
                            android:text="@string/home_stat_total" />
                    </LinearLayout>

                    <LinearLayout style="@style/HomeStatNumberRow">

                        <TextView
                            android:id="@+id/statTotalValue"
                            style="@style/HomeStatValue"
                            tools:text="248" />

                        <TextView
                            style="@style/HomeStatUnit"
                            android:text="@string/home_stat_unit_items" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 影像存档 -->
                <LinearLayout style="@style/HomeStatTile">

                    <LinearLayout style="@style/HomeStatHead">

                        <ImageView
                            style="@style/HomeStatIcon"
                            android:src="@drawable/ic_setting_image"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/HomeStatLabel"
                            android:text="@string/home_stat_image" />
                    </LinearLayout>

                    <LinearLayout style="@style/HomeStatNumberRow">

                        <TextView
                            android:id="@+id/statImageValue"
                            style="@style/HomeStatValue"
                            tools:text="86" />

                        <TextView
                            style="@style/HomeStatUnit"
                            android:text="@string/home_stat_unit_images" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- ══════ 主扫描卡 ══════ -->
            <LinearLayout
                android:id="@+id/cardScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_home_hero"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_5"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/space_5"
                android:paddingBottom="@dimen/space_8">

                <ImageView
                    android:layout_width="@dimen/size_avatar"
                    android:layout_height="@dimen/size_avatar"
                    android:contentDescription="@string/home_hero_title"
                    android:src="@drawable/ic_scan_box"
                    app:tint="@color/text_inverse" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_hero_title"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_xl"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/home_hero_desc"
                        android:textColor="@color/white_90"
                        android:textSize="@dimen/text_md" />
                </LinearLayout>

            </LinearLayout>

            <!-- ══════ 模式卡 2×2 ══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardBarcodeOnly"
                    style="@style/HomeModeCard"
                    android:layout_marginEnd="@dimen/space_3">

                    <ImageView
                        style="@style/HomeModeIcon"
                        android:src="@drawable/ic_mode_barcode"
                        app:tint="@color/text_secondary" />

                    <LinearLayout style="@style/HomeModeText">

                        <TextView
                            style="@style/HomeModeTitle"
                            android:text="@string/home_card_barcode" />

                    </LinearLayout>

                    <ImageView style="@style/HomeModeChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardQrOnly"
                    style="@style/HomeModeCard">

                    <ImageView
                        style="@style/HomeModeIcon"
                        android:src="@drawable/ic_mode_qrcode"
                        app:tint="@color/text_secondary" />

                    <LinearLayout style="@style/HomeModeText">

                        <TextView
                            style="@style/HomeModeTitle"
                            android:text="@string/home_card_qrcode" />

                    </LinearLayout>

                    <ImageView style="@style/HomeModeChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardContinuous"
                    style="@style/HomeModeCard"
                    android:layout_marginEnd="@dimen/space_3">

                    <ImageView
                        style="@style/HomeModeIcon"
                        android:src="@drawable/ic_mode_continuous"
                        app:tint="@color/text_secondary" />

                    <LinearLayout style="@style/HomeModeText">

                        <TextView
                            style="@style/HomeModeTitle"
                            android:text="@string/home_card_continuous" />

                    </LinearLayout>

                    <ImageView style="@style/HomeModeChevron" />
                </LinearLayout>

                <!-- HomeModeCard 是 weight=1，本行只剩一张卡时会撑满整行、
                     与上一行两张半宽卡不齐。占位撑掉右半边，保持半宽左对齐。 -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════ 底部导航 ══════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_4">

        <LinearLayout
            android:id="@+id/homeTab"
            style="@style/HomeNavTab">

            <ImageView
                style="@style/HomeNavIcon"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/brand_primary" />

            <TextView
                style="@style/HomeNavLabel"
                android:text="@string/bottom_nav_home"
                android:textColor="@color/brand_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/historyTab"
            style="@style/HomeNavTab">

            <ImageView
                style="@style/HomeNavIcon"
                android:src="@drawable/ic_nav_history"
                app:tint="@color/text_hint" />

            <TextView
                style="@style/HomeNavLabel"
                android:text="@string/bottom_nav_history" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mineTab"
            style="@style/HomeNavTab">

            <ImageView
                style="@style/HomeNavIcon"
                android:src="@drawable/ic_nav_mine"
                app:tint="@color/text_hint" />

            <TextView
                style="@style/HomeNavLabel"
                android:text="@string/bottom_nav_settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
