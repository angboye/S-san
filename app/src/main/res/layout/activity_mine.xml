<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <!-- 顶栏：浅色标题区（对照 design/settings.png） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/screen_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_5"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_5"
        android:paddingBottom="@dimen/space_4">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_5"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/space_5"
            android:paddingBottom="32dp">

            <!-- 账号信息 -->
            <LinearLayout
                style="@style/SettingsCard"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_4">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_mine_avatar"
                    android:contentDescription="@string/settings_title"
                    android:padding="@dimen/space_2"
                    android:src="@drawable/ic_home_member"
                    app:tint="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/userNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_user_name_value"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/userPhoneText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/settings_user_phone_value"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════ 扫描反馈 ══════════ -->
            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/settings_section_feedback" />

                <LinearLayout
                    android:id="@+id/rowScanSpeech"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_voice" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_scan_speech_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_scan_speech_summary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchScanSpeech"
                        style="@style/SettingsRowSwitch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowVibration"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_vibration" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_vibration_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_vibration_summary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchVibration"
                        style="@style/SettingsRowSwitch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowTone"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_sound" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_tone_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_tone_summary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchTone"
                        style="@style/SettingsRowSwitch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowDuplicateSpeech"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_voice" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_duplicate_speech_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_duplicate_speech_summary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDuplicateSpeech"
                        style="@style/SettingsRowSwitch" />
                </LinearLayout>

            </LinearLayout>

            <!-- ══════════ 扫描行为 ══════════ -->
            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/settings_section_behavior" />

                <LinearLayout
                    android:id="@+id/rowAllowDuplicate"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_barcode" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_allow_duplicate_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_allow_duplicate_summary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAllowDuplicate"
                        style="@style/SettingsRowSwitch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowInterval"
                    style="@style/SettingsRowClickable">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_timer" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_continuous_interval_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_continuous_interval_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/rowIntervalSummary"
                        style="@style/SettingsRowValue"
                        android:text="@string/settings_continuous_interval_option" />

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowAutoCopy"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_copy" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_auto_copy_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_auto_copy_summary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoCopy"
                        style="@style/SettingsRowSwitch" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════ 存储设置 ══════════ -->
            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/settings_section_storage" />

                <LinearLayout
                    android:id="@+id/rowSaveImage"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_image" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_save_scan_image_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_save_scan_image_summary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSaveImage"
                        style="@style/SettingsRowSwitch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowSaveToAlbum"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_album" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_auto_save_album_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_auto_save_album_summary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSaveToAlbum"
                        style="@style/SettingsRowSwitch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowSaveSeparateFolder"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_folder" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_save_separate_folder_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_save_separate_folder_summary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSaveSeparateFolder"
                        style="@style/SettingsRowSwitch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowClearCache"
                    style="@style/SettingsRowClickable">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_cache" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_clear_cache_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_clear_cache_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/rowCacheSize"
                        style="@style/SettingsRowValue"
                        android:text="@string/settings_cache_size_value" />

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════ 通用设置 ══════════ -->
            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/settings_section_general" />

                <LinearLayout
                    android:id="@+id/rowLanguage"
                    style="@style/SettingsRowClickable">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_language" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_language_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_language_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/rowLanguageValue"
                        style="@style/SettingsRowValue"
                        android:text="@string/settings_language_follow_system" />

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowTheme"
                    style="@style/SettingsRowClickable">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_theme" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_theme_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_theme_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/rowThemeValue"
                        style="@style/SettingsRowValue"
                        android:text="@string/settings_theme_follow_system" />

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowClearConfirm"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_shield" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_clear_confirm_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_clear_confirm_summary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchClearConfirm"
                        style="@style/SettingsRowSwitch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowClearHistory"
                    style="@style/SettingsRowClickable">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_history"
                        app:tint="@color/brand_danger" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_clear_history_title"
                            android:textColor="@color/brand_danger" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_clear_history_summary" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowCheckUpdate"
                    style="@style/SettingsRowClickable">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_update" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_check_update_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_check_update_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/rowVersionText"
                        style="@style/SettingsRowValue"
                        android:text="@string/settings_version_value" />

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowAbout"
                    style="@style/SettingsRowClickable">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_setting_info" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_about_title" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_about_summary" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- 退出登录 -->
            <TextView
                android:id="@+id/rowLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_6"
                android:layout_marginBottom="@dimen/space_4"
                android:background="@drawable/bg_mine_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/login_logout_confirm"
                android:textColor="@color/brand_danger"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
