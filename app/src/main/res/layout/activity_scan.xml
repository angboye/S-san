<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".feature.scan.presentation.ScanActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <com.example.sscan.feature.scan.presentation.BarcodeOverlayView
        android:id="@+id/barcodeOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 上下压暗，突出中央取景区 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scan_top_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scan_bottom_scrim" />

    <!-- ══════ 取景框：四角蓝色角标 + 扫描线 ══════ -->
    <FrameLayout
        android:id="@+id/scanFrame"
        android:layout_width="match_parent"
        android:layout_height="248dp"
        android:layout_gravity="center"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="44dp">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_scan_corner_top_left" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_scan_corner_top_right" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/bg_scan_corner_bottom_left" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_scan_corner_bottom_right" />

        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_1"
            android:layout_gravity="center_horizontal|top"
            android:background="@drawable/bg_scan_line" />
    </FrameLayout>

    <!-- ══════ 顶栏：返回 + 标题 ══════ -->
    <LinearLayout
        android:id="@+id/topOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="44dp"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_1">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/page_back"
            android:padding="@dimen/space_2"
            android:src="@drawable/ic_back"
            app:tint="@color/text_inverse" />

        <TextView
            android:id="@+id/scanTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/scan_panel_title"
            android:textColor="@color/text_inverse"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- ══════ 状态胶囊：平时显示目标文件夹，可点着改 ══════ -->
    <LinearLayout
        android:id="@+id/scanStatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/size_touch"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="@dimen/space_6"
        android:background="@drawable/bg_scan_status_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_2">

        <View
            android:layout_width="@dimen/space_2"
            android:layout_height="@dimen/space_2"
            android:background="@drawable/bg_scan_status_dot" />

        <TextView
            android:id="@+id/scanStatusValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/scan_status_waiting"
            android:textColor="@color/text_inverse"
            android:textSize="@dimen/text_md" />
    </LinearLayout>

    <!-- ══════ 实时结果卡（扫到码时弹出） ══════ -->
    <LinearLayout
        android:id="@+id/liveResultCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        android:layout_marginBottom="216dp"
        android:background="@drawable/bg_scan_live_result_card"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_4">

            <TextView
                android:id="@+id/liveNewLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_live_new_badge"
                android:textColor="@color/brand_danger"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_marginEnd="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/liveLatestContentText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold"
                    tools:text="HTTPS://Y2WM.CN/99.1000.1/AC10317120001" />

                <TextView
                    android:id="@+id/liveLatestTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textColor="@color/white_90"
                    android:textSize="@dimen/text_sm"
                    tools:text="23:02:01" />
            </LinearLayout>

            <ImageView
                android:id="@+id/liveLatestImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/scrim"
                android:contentDescription="@string/history_action_view_image"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:src="@android:drawable/ic_menu_report_image"
                tools:visibility="visible" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_overlay_soft" />

        <TextView
            android:id="@+id/liveResultAction"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/scan_live_action_all"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_md"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══════ 底部控件：功能区（下划线隔离）+ 圆形按钮 ══════ -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="20dp">

        <!-- 功能区：闪光灯 | 相册读取 / 连续扫描 / 只扫二维码 | 只扫条码，下划线隔离 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 第一行：闪光灯 | 相册读取 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_1"
                android:paddingBottom="@dimen/space_1">

                <LinearLayout
                    android:id="@+id/flashToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/flashIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/scan_flashlight"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/text_inverse" />

                    <TextView
                        android:id="@+id/flashText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/scan_flashlight"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_md" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="@color/surface_overlay_soft" />

                <LinearLayout
                    android:id="@+id/albumReadButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/scan_album_read"
                        android:src="@drawable/ic_setting_album"
                        app:tint="@color/text_inverse" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/scan_album_read"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_md" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_overlay_soft" />

            <!-- 第二行：连续扫描 -->
            <LinearLayout
                android:id="@+id/continuousRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_1"
                android:paddingBottom="@dimen/space_1">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/scan_mode_continuous_short"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_md" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/continuousScanSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:scaleX="0.8"
                    android:scaleY="0.8"
                    app:switchMinWidth="34dp"
                    app:thumbTint="@color/text_inverse"
                    app:trackTint="@color/switch_track_scan" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_overlay_soft" />

            <!-- 第三行：只扫二维码 | 只扫条码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_1"
                android:paddingBottom="@dimen/space_1">

                <LinearLayout
                    android:id="@+id/qrModeContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="@dimen/space_2">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/scan_mode_qr_short"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_md" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/qrOnlySwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        app:switchMinWidth="34dp"
                        app:thumbTint="@color/text_inverse"
                        app:trackTint="@color/switch_track_scan" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="@color/surface_overlay_soft" />

                <LinearLayout
                    android:id="@+id/barcodeModeContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginStart="@dimen/space_4"
                    android:paddingStart="@dimen/space_2">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/scan_mode_barcode_short"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_md" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/barcodeOnlySwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        app:switchMinWidth="34dp"
                        app:thumbTint="@color/text_inverse"
                        app:trackTint="@color/switch_track_scan" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 底部圆形按钮：重置对焦 / 已扫数量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout style="@style/ScanCtrlColumn">

                <LinearLayout
                    android:id="@+id/resetFocusButton"
                    style="@style/ScanCtrlCircle">

                    <ImageView
                        android:layout_width="@dimen/size_icon"
                        android:layout_height="@dimen/size_icon"
                        android:contentDescription="@string/scan_reset_focus"
                        android:src="@drawable/ic_setting_focus"
                        app:tint="@color/text_inverse" />
                </LinearLayout>

                <TextView
                    style="@style/ScanCtrlLabel"
                    android:text="@string/scan_reset_focus" />
            </LinearLayout>

            <LinearLayout style="@style/ScanCtrlColumn">

                <LinearLayout style="@style/ScanCtrlCircle">

                    <TextView
                        android:id="@+id/liveScanCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_count_zero"
                        android:textColor="@color/brand_primary"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold"
                        tools:text="12" />
                </LinearLayout>

                <TextView
                    style="@style/ScanCtrlLabel"
                    android:text="@string/scan_count_label" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
