<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="@dimen/space_4"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/space_4"
    android:paddingBottom="@dimen/space_3">

    <!-- 拖拽指示条 -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="@dimen/space_1"
        android:layout_marginBottom="@dimen/space_1"
        android:background="@drawable/bg_drag_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 相机图标 -->
    <ImageView
        android:id="@+id/iconCamera"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/space_2"
        android:background="@drawable/bg_icon_circle"
        android:padding="@dimen/space_2"
        android:src="@drawable/ic_camera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dragHandle" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/scan_permission_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_md"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iconCamera"
        app:layout_constraintTop_toBottomOf="@id/dragHandle" />

    <TextView
        android:id="@+id/descText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:lineSpacingExtra="3dp"
        android:text="@string/scan_permission_desc"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText" />

    <LinearLayout
        android:id="@+id/buttonBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/descText">

        <TextView
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_1"
            android:text="@string/scan_permission_retry"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_md" />

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_1"
            android:text="@string/scan_permission_settings"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_md"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
